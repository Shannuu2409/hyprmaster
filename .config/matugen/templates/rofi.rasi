/* Shanmukha Kumar Karra — matugen rofi colors */
* {
    background-color: rgba({{colors.surface.default.hex_stripped}}, 0.85);
    text-color: #{{colors.on_surface.default.hex_stripped}};
    border-color: rgba({{colors.outline.default.hex_stripped}}, 0.4);
    selected-normal-background: rgba({{colors.primary.default.hex_stripped}}, 0.35);
    selected-normal-foreground: #{{colors.on_primary.default.hex_stripped}};
}
